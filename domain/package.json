{
  "name": "domain",
  "private": true,
  "scripts": {
    "start": "cross-env PORT=3004 tsx src/server.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "test:integration": "cross-env APP_TARGET=domain npm --prefix .. run test:integration",
    "lint": "eslint src test --ext .ts",
    "architecture": "depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^9.0.8"
  }
}
